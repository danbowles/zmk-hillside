#include "hillside48.dtsi"

&i2c0 {
    status = "okay";

    trackball_pim447: trackball@0a {
        compatible = "pimoroni,trackball_pim447";
        reg = <0x0A>;
        label = "PIM447";

        /* Make the module light up at boot = driver probed + I²C OK */
        led-red = <64>;
        led-green = <0>;
        led-blue = <0>;

        /* Conservative motion settings; we can tune later */
        sensitivity = <64>;
        move-factor = <2>;
        scroll-factor = <1>;
    };
};

/* Minimal listener: raw motion -> HID (no processors) */
/ {
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_pim447>;
    };
}
