#include "hillside48.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 10 GPIO_ACTIVE_HIGH> // col5 in the schematic
        , <&pro_micro 16 GPIO_ACTIVE_HIGH> // col4 in the schematic
        , <&pro_micro 14 GPIO_ACTIVE_HIGH> // col3 in the schematic
        , <&pro_micro 15 GPIO_ACTIVE_HIGH> // col2 in the schematic
        , <&pro_micro 18 GPIO_ACTIVE_HIGH> // col1 in the schematic
        , <&pro_micro 19 GPIO_ACTIVE_HIGH> // col0 in the schematic
        ;
};

&right_encoder {
    status = "okay";
};

/* === Pimoroni PIM447 on I²C (default address 0x0A) ===
 * If this doesn't probe, change &i2c0 -> &i2c1 and rebuild.
 */
&i2c0 {
    status = "okay";

    // compatible = "nordic,nrf-twi";
    // pinctrl-0 = <&i2c0_default>;
    // pinctrl-1 = <&i2c0_sleep>;
    // pinctrl-names = "default", "sleep";
    // clock-frequency = <I2C_BITRATE_FAST>;

    trackball: pim447@0a {
        compatible = "pimoroni,pim447";
        reg = <0x0a>; // The default I2C address for the Pimoroni trackball
        
        // This is highly recommended for wireless/power saving.
        // You'll need to select an UNUSED GPIO pin on the nice!nano (e.g., P0.31 or D10)
        // and wire the trackball's INT pin to it.
        // **YOU MUST CONFIRM THIS PIN IS UNUSED ON YOUR HILLSIDE PCB**
        // A common available pin for the nice!nano is `P0.31` (D10 on the Pro Micro footprint)
        // int-gpios = <&pro_micro 10 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; 

        status = "okay";
    };

};
