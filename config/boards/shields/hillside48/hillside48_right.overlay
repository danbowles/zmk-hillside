#include "hillside48.dtsi"
#include <dt-bindings/zmk/trackball_pim447.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 10 GPIO_ACTIVE_HIGH> // col5 in the schematic
        , <&pro_micro 16 GPIO_ACTIVE_HIGH> // col4 in the schematic
        , <&pro_micro 14 GPIO_ACTIVE_HIGH> // col3 in the schematic
        , <&pro_micro 15 GPIO_ACTIVE_HIGH> // col2 in the schematic
        , <&pro_micro 18 GPIO_ACTIVE_HIGH> // col1 in the schematic
        , <&pro_micro 19 GPIO_ACTIVE_HIGH> // col0 in the schematic
        ;
};

&right_encoder {
    status = "okay";
};

&i2c0 {
  status = "okay";

  trackball_pim447@a {
    compatible = "pimoroni,trackball_pim447";
    reg = <0xa>;
    label = "TRACKBALL_PIM447";
    mode = <PIM447_MOVE>;
    move-factor-x = <100>;
    move-factor-y = <100>;
    move-inertia-x = <66>;
    move-inertia-y = <66>;
    norm = <PIM447_NORM_MAX>; 
    exactness = <4>;      
    max-accel = <100>;    
    // invert-move-x;        
    // invert-move-y;        
    scroll-divisor-x = <1>;      
    scroll-divisor-y = <1>;      
    invert-scroll-x;      
    invert-scroll-y;      
    button = <0>;         
    // swap-axes;           
    poll-interval = <20>; 
    power-layer = <0>;
    idle-timeout = <60>;  
  };
};
